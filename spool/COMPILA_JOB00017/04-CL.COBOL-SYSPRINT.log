000105
000106        *----------------------------------------------------------------*
000107        * ALGORITMO DE LUHN (PRONTO, PARA LEITURA COMENTADA): PERCORRE   *
000108        * OS DIGITOS DA DIREITA PARA A ESQUERDA, DOBRA UM SIM E UM NAO A *
000109        * PARTIR DO PENULTIMO, SUBTRAI 9 DE TODA PARCELA MAIOR QUE 9 E   *
000110        * SOMA TUDO. O NUMERO E VALIDO QUANDO A SOMA E MULTIPLA DE 10.   *
000111        *----------------------------------------------------------------*
000112         9100-VALIDAR-LUHN.
000113             SET WS-LUHN-INVALIDO   TO TRUE
000114             IF WS-LUHN-CARTAO IS NUMERIC
000115                MOVE ZERO              TO WS-LUHN-SOMA
000116                SET WS-LUHN-NAO-DOBRA  TO TRUE
000117                PERFORM VARYING WS-LUHN-POS FROM 16 BY -1
000118                        UNTIL WS-LUHN-POS < 1
000119                   MOVE WS-LUHN-DIGITO(WS-LUHN-POS) TO WS-LUHN-PARCELA
000120                   IF WS-LUHN-DOBRA
000121                      COMPUTE WS-LUHN-PARCELA = WS-LUHN-PARCELA * 2
000122                      IF WS-LUHN-PARCELA > 9
000123                         SUBTRACT 9 FROM WS-LUHN-PARCELA
000124                      END-IF
000125                      SET WS-LUHN-NAO-DOBRA TO TRUE
000126                   ELSE
000127                      SET WS-LUHN-DOBRA     TO TRUE
000128                   END-IF
000129                   ADD WS-LUHN-PARCELA TO WS-LUHN-SOMA
000130                END-PERFORM
000131                IF FUNCTION MOD(WS-LUHN-SOMA, 10) = ZERO
000132                   SET WS-LUHN-VALIDO TO TRUE
000133                END-IF
000134             END-IF
000135             .


