        1       *================================================================*
        2       * PROGRAMA : FATCONCI                                            *
        3       * AULA     : 9 - BALANCE LINE                                    *
        4       * OBJETIVO : CRUZAR FATURAS EM ABERTO COM PAGAMENTOS DO DIA,     *
        5       *            AMBOS ORDENADOS POR CARTAO, BAIXANDO AS FATURAS     *
        6       *            PAGAS E GRAVANDO AS DIVERGENCIAS:                   *
        7       *            PS = PAGAMENTO SEM FATURA                           *
        8       *            FS = FATURA SEM PAGAMENTO                           *
        9       *            PM = PAGAMENTO A MENOR                              *
       10       * ENTRADAS : DD FATIN   - CPFATUR, FB 80                         *
       11       *            DD PAGIN   - CPPAGTO, FB 80                         *
       12       * SAIDA    : DD DIVEROUT - CPDIVER, FB 80                        *
       13       * PREMISSA : NO MAXIMO UM PAGAMENTO E UMA FATURA POR CARTAO.     *
       14       * ORDEM    : ENTRADAS EM ORDEM CRESCENTE DE CARTAO (VALIDADO)    *
       15       * RC       : 0 = OK, 16 = ERRO DE ARQUIVO, CHAVE FORA DE ORDEM   *
       16       *            OU CONTAS NAO FECHAM                                *
       17       *================================================================*
       18        IDENTIFICATION DIVISION.
       19        PROGRAM-ID. FATCONCI.
       20 
       21        ENVIRONMENT DIVISION.
       22        INPUT-OUTPUT SECTION.
       23        FILE-CONTROL.
       24            SELECT FATURAS     ASSIGN TO FATIN
       25                   FILE STATUS IS WS-FS-FATURA.
       26            SELECT PAGAMENTOS  ASSIGN TO PAGIN
       27                   FILE STATUS IS WS-FS-PAGTO.
       28            SELECT DIVERGENCIAS ASSIGN TO DIVEROUT
       29                   FILE STATUS IS WS-FS-DIVER.
       30 
       31        DATA DIVISION.
       32        FILE SECTION.
       33        FD  FATURAS
       34            RECORDING MODE IS F.
       35            COPY CPFATUR.
       36        FD  PAGAMENTOS
       37            RECORDING MODE IS F.
       38            COPY CPPAGTO.
       39        FD  DIVERGENCIAS
       40            RECORDING MODE IS F.
       41            COPY CPDIVER.
       42 
       43        WORKING-STORAGE SECTION.
       44        01  WS-FS-FATURA               PIC X(02).
       45            88  WS-FS-FAT-OK                     VALUE '00'.
       46            88  WS-FS-FAT-FIM                    VALUE '10'.
       47        01  WS-FS-PAGTO                PIC X(02).
       48            88  WS-FS-PAG-OK                     VALUE '00'.
       49            88  WS-FS-PAG-FIM                    VALUE '10'.
       50        01  WS-FS-DIVER                PIC X(02).
       51            88  WS-FS-DIV-OK                     VALUE '00'.
       52 
       53       *--- CHAVES DO BALANCE LINE: HIGH-VALUES QUANDO O ARQUIVO ACABA -*
       54        01  WS-CHAVE-FATURA            PIC X(16).
       55        01  WS-CHAVE-PAGTO             PIC X(16).
       56 
       57       *--- ULTIMA CHAVE LIDA: CONFERE A ORDEM DOS ARQUIVOS DE ENTRADA -*
       58        01  WS-CHAVE-FAT-ANT           PIC X(16) VALUE LOW-VALUES.
       59        01  WS-CHAVE-PAG-ANT           PIC X(16) VALUE LOW-VALUES.
       60 
       61        01  WS-CONTADORES.
       62            05  WS-QTD-FAT-LIDAS       PIC 9(07) VALUE ZERO.
       63            05  WS-QTD-PAG-LIDOS       PIC 9(07) VALUE ZERO.
       64            05  WS-QTD-BAIXADAS        PIC 9(07) VALUE ZERO.
       65            05  WS-QTD-PS              PIC 9(07) VALUE ZERO.
       66            05  WS-QTD-FS              PIC 9(07) VALUE ZERO.
       67            05  WS-QTD-PM              PIC 9(07) VALUE ZERO.
       68 
       69        01  WS-CARTAO-ABERTO           PIC X(16).
       70        01  WS-CARTAO-MASC             PIC X(16).
       71 
       72        PROCEDURE DIVISION.
       73        0000-PRINCIPAL.
       74            PERFORM 1000-INICIALIZAR THRU 1000-FIM-INICIALIZAR
       75            PERFORM 2000-CONCILIAR   THRU 2000-FIM-CONCILIAR
       76               UNTIL WS-CHAVE-FATURA = HIGH-VALUES
       77                 AND WS-CHAVE-PAGTO  = HIGH-VALUES
       78            PERFORM 3000-FINALIZAR   THRU 3000-FIM-FINALIZAR
       79            STOP RUN.
       80        0000-FIM-PRINCIPAL.
       81            EXIT.
       82 
       83        1000-INICIALIZAR.
       84 
       85            OPEN INPUT FATURAS
       86            IF NOT WS-FS-FAT-OK
       87               DISPLAY 'FATCONCI - ERRO DE OPEN FATURAS (FATIN)'
       88               DISPLAY 'FS: ' WS-FS-FATURA
       89               PERFORM 9900-ENCERRAR-COM-ERRO
       90                  THRU 9900-FIM-ENCERRAR-COM-ERRO
       91            END-IF
       92 
       93            OPEN INPUT PAGAMENTOS
       94            IF NOT WS-FS-PAG-OK
       95               DISPLAY 'FATCONCI - ERRO DE OPEN PAGAMENTOS (PAGIN)'
       96               DISPLAY 'FS: ' WS-FS-PAGTO
       97               PERFORM 9900-ENCERRAR-COM-ERRO
       98                  THRU 9900-FIM-ENCERRAR-COM-ERRO
       99            END-IF
      100 
      101            OPEN OUTPUT DIVERGENCIAS
      102            IF NOT WS-FS-DIV-OK
      103               DISPLAY 'FATCONCI - ERRO DE OPEN DIVERGENCIAS (DIVEROUT)'
      104               DISPLAY 'FS: ' WS-FS-DIVER
      105               PERFORM 9900-ENCERRAR-COM-ERRO
      106                  THRU 9900-FIM-ENCERRAR-COM-ERRO
      107            END-IF
      108 
      109            PERFORM 8100-LER-FATURA    THRU 8100-FIM-LER-FATURA
      110            PERFORM 8200-LER-PAGAMENTO THRU 8200-FIM-LER-PAGAMENTO.
      111 
      112        1000-FIM-INICIALIZAR.
      113            EXIT.
      114 
      115        2000-CONCILIAR.
      116 
      117            EVALUATE TRUE
      118               WHEN WS-CHAVE-FATURA = WS-CHAVE-PAGTO
      119                  IF PG-VALOR < FT-VALOR
      120                     MOVE SPACES TO REG-DIVERGENCIA
      121                     SET DV-PAGTO-A-MENOR TO TRUE
      122                     PERFORM 7000-GRAVAR-DIVERGENCIA
      123                        THRU 7000-FIM-GRAVAR-DIVERGENCIA
      124                     ADD 1 TO WS-QTD-PM
      125                  ELSE
      126                     ADD 1 TO WS-QTD-BAIXADAS
      127                  END-IF
      128                  PERFORM 8100-LER-FATURA    THRU 8100-FIM-LER-FATURA
      129                  PERFORM 8200-LER-PAGAMENTO THRU 8200-FIM-LER-PAGAMENTO
      130               WHEN WS-CHAVE-FATURA < WS-CHAVE-PAGTO
      131                  MOVE SPACES TO REG-DIVERGENCIA
      132                  SET DV-FATURA-SEM-PAGTO TO TRUE
      133                  PERFORM 7000-GRAVAR-DIVERGENCIA
      134                     THRU 7000-FIM-GRAVAR-DIVERGENCIA
      135                  ADD 1 TO WS-QTD-FS
      136                  PERFORM 8100-LER-FATURA    THRU 8100-FIM-LER-FATURA
      137               WHEN OTHER
      138                  MOVE SPACES TO REG-DIVERGENCIA
      139                  SET DV-PAGTO-SEM-FATURA TO TRUE
      140                  PERFORM 7000-GRAVAR-DIVERGENCIA
      141                     THRU 7000-FIM-GRAVAR-DIVERGENCIA
      142                  ADD 1 TO WS-QTD-PS
      143                  PERFORM 8200-LER-PAGAMENTO THRU 8200-FIM-LER-PAGAMENTO
      144            END-EVALUATE.
      145 
      146        2000-FIM-CONCILIAR.
      147            EXIT.
      148 
      149        3000-FINALIZAR.
      150 
      151            CLOSE FATURAS
      152            IF NOT WS-FS-FAT-OK
      153               DISPLAY 'FATCONCI - ERRO DE CLOSE FATURAS (FATIN)'
      154               DISPLAY 'FS: ' WS-FS-FATURA
      155               PERFORM 9900-ENCERRAR-COM-ERRO
      156                  THRU 9900-FIM-ENCERRAR-COM-ERRO
      157            END-IF
      158 
      159            CLOSE PAGAMENTOS
      160            IF NOT WS-FS-PAG-OK
      161               DISPLAY 'FATCONCI - ERRO DE CLOSE PAGAMENTOS (PAGIN)'
      162               DISPLAY 'FS: ' WS-FS-PAGTO
      163               PERFORM 9900-ENCERRAR-COM-ERRO
      164                  THRU 9900-FIM-ENCERRAR-COM-ERRO
      165            END-IF
      166 
      167            CLOSE DIVERGENCIAS
      168            IF NOT WS-FS-DIV-OK
      169               DISPLAY 'FATCONCI - ERRO DE CLOSE DIVERGENCIAS (DIVEROUT)'
      170               DISPLAY 'FS: ' WS-FS-DIVER
      171               PERFORM 9900-ENCERRAR-COM-ERRO
      172                  THRU 9900-FIM-ENCERRAR-COM-ERRO
      173            END-IF
      174 
      175            DISPLAY 'FATCONCI - FATURAS LIDAS .........: '
      176                    WS-QTD-FAT-LIDAS
      177            DISPLAY 'FATCONCI - PAGAMENTOS LIDOS ......: '
      178                    WS-QTD-PAG-LIDOS
      179            DISPLAY 'FATCONCI - FATURAS BAIXADAS ......: '
      180                    WS-QTD-BAIXADAS
      181            DISPLAY 'FATCONCI - PAGAMENTO SEM FATURA ...: ' WS-QTD-PS
      182            DISPLAY 'FATCONCI - FATURA SEM PAGAMENTO ...: ' WS-QTD-FS
      183            DISPLAY 'FATCONCI - PAGAMENTO A MENOR ......: ' WS-QTD-PM
      184 
      185       *    CONFERENCIA PELOS DOIS LADOS:
      186       *    FATURAS    = BAIXADAS + A MENOR + SEM PAGAMENTO
      187       *    PAGAMENTOS = BAIXADAS + A MENOR + SEM FATURA
      188            IF WS-QTD-FAT-LIDAS NOT =
      189                  WS-QTD-BAIXADAS + WS-QTD-PM + WS-QTD-FS
      190            OR WS-QTD-PAG-LIDOS NOT =
      191                  WS-QTD-BAIXADAS + WS-QTD-PM + WS-QTD-PS
      192               DISPLAY 'FATCONCI - CONTADORES NAO FECHAM'
      193               MOVE 16 TO RETURN-CODE
      194            END-IF.
      195 
      196        3000-FIM-FINALIZAR.
      197            EXIT.
      198 
      199        7000-GRAVAR-DIVERGENCIA.
      200       *    O REGISTRO FOI LIMPO (MOVE SPACES, INCLUSIVE O FILLER) ANTES
      201       *    DO SET DO TIPO, NO PARAGRAFO QUE CHAMOU ESTE.
      202 
      203            IF DV-PAGTO-SEM-FATURA
      204               MOVE PG-NUM-CARTAO TO WS-CARTAO-ABERTO
      205               MOVE ZERO          TO DV-VALOR-FATURA
      206               MOVE PG-VALOR      TO DV-VALOR-PAGO
      207            ELSE
      208               MOVE FT-NUM-CARTAO TO WS-CARTAO-ABERTO
      209               MOVE FT-VALOR      TO DV-VALOR-FATURA
      210               IF DV-PAGTO-A-MENOR
      211                  MOVE PG-VALOR   TO DV-VALOR-PAGO
      212               ELSE
      213                  MOVE ZERO       TO DV-VALOR-PAGO
      214               END-IF
      215            END-IF
      216            PERFORM 9800-MASCARAR-CARTAO
      217            MOVE WS-CARTAO-MASC TO DV-NUM-CARTAO-MASC
      218 
      219            WRITE REG-DIVERGENCIA
      220            IF NOT WS-FS-DIV-OK
      221               DISPLAY 'FATCONCI - ERRO DE WRITE DIVERGENCIAS (DIVEROUT)'
      222               DISPLAY 'FS: ' WS-FS-DIVER
      223               PERFORM 9900-ENCERRAR-COM-ERRO
      224                  THRU 9900-FIM-ENCERRAR-COM-ERRO
      225            END-IF.
      226 
      227        7000-FIM-GRAVAR-DIVERGENCIA.
      228            EXIT.
      229 
      230        8100-LER-FATURA.
      231 
      232            READ FATURAS
      233                 AT END
      234                    MOVE HIGH-VALUES   TO WS-CHAVE-FATURA
      235                 NOT AT END
      236                    ADD 1              TO WS-QTD-FAT-LIDAS
      237                    MOVE FT-NUM-CARTAO TO WS-CHAVE-FATURA
      238                    IF WS-CHAVE-FATURA < WS-CHAVE-FAT-ANT
      239                       DISPLAY 'FATCONCI - FATIN FORA DE ORDEM'
      240                       DISPLAY 'REGISTRO NUMERO: ' WS-QTD-FAT-LIDAS
      241                       PERFORM 9900-ENCERRAR-COM-ERRO
      242                          THRU 9900-FIM-ENCERRAR-COM-ERRO
      243                    END-IF
      244                    MOVE WS-CHAVE-FATURA TO WS-CHAVE-FAT-ANT
      245            END-READ
      246 
      247            IF NOT WS-FS-FAT-OK AND NOT WS-FS-FAT-FIM
      248               DISPLAY 'FATCONCI - ERRO DE READ FATURAS (FATIN)'
      249               DISPLAY 'FS: ' WS-FS-FATURA
      250               PERFORM 9900-ENCERRAR-COM-ERRO
      251                  THRU 9900-FIM-ENCERRAR-COM-ERRO
      252            END-IF.
      253 
      254        8100-FIM-LER-FATURA.
      255            EXIT.
      256 
      257        8200-LER-PAGAMENTO.
      258 
      259            READ PAGAMENTOS
      260                 AT END
      261                    MOVE HIGH-VALUES   TO WS-CHAVE-PAGTO
      262                 NOT AT END
      263                    ADD 1              TO WS-QTD-PAG-LIDOS
      264                    MOVE PG-NUM-CARTAO TO WS-CHAVE-PAGTO
      265                    IF WS-CHAVE-PAGTO < WS-CHAVE-PAG-ANT
      266                       DISPLAY 'FATCONCI - PAGIN FORA DE ORDEM'
      267                       DISPLAY 'REGISTRO NUMERO: ' WS-QTD-PAG-LIDOS
      268                       PERFORM 9900-ENCERRAR-COM-ERRO
      269                          THRU 9900-FIM-ENCERRAR-COM-ERRO
      270                    END-IF
      271                    MOVE WS-CHAVE-PAGTO TO WS-CHAVE-PAG-ANT
      272            END-READ
      273 
      274            IF NOT WS-FS-PAG-OK AND NOT WS-FS-PAG-FIM
      275               DISPLAY 'FATCONCI - ERRO DE READ PAGAMENTOS (PAGIN)'
      276               DISPLAY 'FS: ' WS-FS-PAGTO
      277               PERFORM 9900-ENCERRAR-COM-ERRO
      278                  THRU 9900-FIM-ENCERRAR-COM-ERRO
      279            END-IF.
      280 
      281        8200-FIM-LER-PAGAMENTO.
      282            EXIT.
      283 
      284            COPY CPMASCAR.
      285 
      286        9900-ENCERRAR-COM-ERRO.
      287       *    ENCERRA COM RC 16 PARA IMPEDIR OS STEPS SEGUINTES.
      288            MOVE 16 TO RETURN-CODE
      289            STOP RUN.
      290        9900-FIM-ENCERRAR-COM-ERRO.
      291            EXIT.
